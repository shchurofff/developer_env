# Внимание: Это пример файла конфигурации.
# Скопируйте этот файл в .env и подставьте свои значения.

# --- База Данных (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres"

# --- Vercel Blob (Файловое хранилище) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Аутентификация (Better Auth) ---
BETTER_AUTH_SECRET="your_super_secret_string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Провайдер GitHub ---
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# --- Провайдер Google ---
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
