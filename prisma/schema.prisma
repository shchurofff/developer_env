// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  startDay    DateTime      @default(now())
  endDay      DateTime?
  status      ProjectStatus @default(WORKING_NOW)
  favicon     String?

  tasks Task[]

  stack Technology[]
}

model Technology {
  id   String @id @default(cuid())
  name String @unique
  icon String

  projects Project[]
}

model Task {
  id       String     @id @default(cuid())
  name     String
  startDay DateTime   @default(now())
  endDay   DateTime?
  status   TaskStatus @default(TODO)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  comments    Comment[]
  timeEntries TimeEntry[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TimeEntry {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  duration    Int
  description String
  createdAt   DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  POSTPONED
}

enum ProjectStatus {
  WORKING_NOW
  WORKED
}
