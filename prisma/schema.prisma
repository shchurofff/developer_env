generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String
  startDay    DateTime      @default(now())
  endDay      DateTime?
  status      ProjectStatus @default(WORKING_NOW)

  tasks Task[]
}

model Task {
  id       String     @id @default(cuid())
  name     String
  startDay DateTime   @default(now())
  endDay   DateTime?
  status   TaskStatus @default(TODO)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  comments    Comment[]
  timeEntries TimeEntry[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])
}

model TimeEntry {
  id          String    @id @default(cuid())
  startTime   DateTime
  endTime     DateTime?
  description String?
  createdAt   DateTime  @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  POSTPONED
}

enum ProjectStatus {
  WORKING_NOW
  WORKED
}
